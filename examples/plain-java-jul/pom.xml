<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>plain-java-jul</artifactId>
    <version>0.5.0</version>
    <name>plain-java-jul</name>
    <description>Stacktale Plain Java JUL Example</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <stacktale.version>1.4.0</stacktale.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.gabrielbbaldez</groupId>
            <artifactId>stacktale-jul</artifactId>
            <version>${stacktale.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <!-- exec:exec, not exec:java. exec:java runs DemoApp inside Maven's own JVM, where
                     JUL's LogManager is already initialized, so java.util.logging.config.file is read
                     too late and silently ignored. Re-reading the config does not help either: the JDK
                     loads the `handlers` classes through the system class loader only, and exec:java
                     puts this project on a child loader (ClassNotFoundException). A forked JVM with
                     the jar on -classpath behaves like the real app. -->
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-Djava.util.logging.config.file=src/main/resources/logging.properties</argument>
                        <argument>-Dstacktale.app.name=order-batch</argument>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>com.example.demo.DemoApp</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
