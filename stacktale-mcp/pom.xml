<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.gabrielbbaldez</groupId>
    <artifactId>stacktale-parent</artifactId>
    <version>1.5.0-SNAPSHOT</version>
  </parent>

  <artifactId>stacktale-mcp</artifactId>
  <packaging>jar</packaging>

  <name>stacktale-mcp</name>
  <description>Read-only MCP server exposing stacktale error reports as tools for AI assistants.</description>

  <properties>
    <stacktale.module.name>io.github.gabrielbbaldez.stacktale.mcp</stacktale.module.name>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.2</version>
    </dependency>
    <!--
      Test scope only, and the reason is the point: st-json/1 has one writer
      (JsonReportRenderer, in core) and one reader (StReportFile, here), and until now no
      build edge between them. A field renamed in the writer left this module's hand-written
      fixture passing while the real server read a missing node (#248). Test scope keeps core
      off the shaded runtime jar, which is why the edge was never there.
    -->
    <dependency>
      <groupId>io.github.gabrielbbaldez</groupId>
      <artifactId>stacktale-core</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.gabrielbbaldez.stacktale.mcp.StacktaleMcpServer</mainClass>
                  <manifestEntries>
                    <Automatic-Module-Name>io.github.gabrielbbaldez.stacktale.mcp</Automatic-Module-Name>
                    <!-- so serverInfo.version reports the real version, not the "dev" fallback -->
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
